FROM python:3.12-slim
WORKDIR /app

COPY pyproject.toml ./
RUN pip install --no-cache-dir \
    fastapi langchain-gigachat openpyxl pandas python-dotenv redis "uvicorn[standard]" streamlit requests

COPY . .

EXPOSE 8501

CMD ["streamlit", "run", "app/dashboard.py", "--server.address=0.0.0.0", "--server.port=8501"]